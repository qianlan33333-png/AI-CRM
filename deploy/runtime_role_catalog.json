{
  "schema_version": 1,
  "artifact_policy": "same_commit_same_artifact",
  "activation_mode": "observe",
  "roles": [
    {
      "role": "web",
      "command": "uvicorn aicrm_next.main:app",
      "responsibilities": ["admin_console", "business_api"],
      "may_call_real_provider": false
    },
    {
      "role": "callback",
      "command": "python scripts/run_wecom_callback_ingress.py",
      "responsibilities": ["signature_verify", "decrypt", "fast_inbox_persist"],
      "may_call_real_provider": false
    },
    {
      "role": "internal_worker",
      "command": "python scripts/run_execution_runtime.py --role internal_worker",
      "responsibilities": ["webhook_inbox", "internal_event", "internal_outbox"],
      "may_call_real_provider": false
    },
    {
      "role": "external_worker",
      "command": "python scripts/run_execution_runtime.py --role external_worker",
      "responsibilities": ["external_effect"],
      "may_call_real_provider": true
    },
    {
      "role": "scheduler",
      "command": "python scripts/run_job_catalog_scheduler.py --dry-run",
      "responsibilities": ["recovery", "reconciliation", "compensation", "clock_intents"],
      "may_call_real_provider": false
    }
  ],
  "cutover_policy": {
    "activate_new_units": false,
    "requires_successor_parity": true,
    "requires_independent_release": true,
    "legacy_units_remain_authoritative": true
  }
}
